# Copy this to .env and fill in your values
# .env is NOT committed to version control

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tfais
DB_USER=postgres
DB_PASSWORD=your_password_here

# Or set the full URL directly (takes precedence)
# DATABASE_URL=postgresql://user:pass@localhost:5432/tfais

# --- Scraper settings ---
RATE_LIMIT_SECONDS=2.0
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/tfais.log

# --- Dashboard ---
TFAIS_API_URL=http://127.0.0.1:8000
